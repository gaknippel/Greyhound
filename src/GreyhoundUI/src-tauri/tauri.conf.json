{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "greyhound",
  "version": "0.1.0",
  "identifier": "com.gaknippel.greyhound",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "greyhound",
        "width": 1200,
        "height": 860,
        "minWidth": 900,
        "minHeight": 580,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
